#!/usr/bin/env bash
# Generate a review package for BASE..HEAD.
# Usage: review-package PLAN_FILE BASE HEAD [OUTFILE]
set -euo pipefail

script_source=${BASH_SOURCE[0]//\\//}
case "$script_source" in
  [A-Za-z]:/*)
    if [ -x /usr/bin/cygpath ]; then
      script_source=$(/usr/bin/cygpath -u "$script_source")
    elif [ -x /usr/bin/cygpath.exe ]; then
      script_source=$(/usr/bin/cygpath.exe -u "$script_source")
    else
      echo "SDD_HELPER_PATH_CONVERSION_FAILED: path=${BASH_SOURCE[0]}" >&2
      exit 2
    fi
    ;;
esac
script_dir=$(case "$script_source" in */*) printf '%s' "${script_source%/*}" ;; *) printf '.' ;; esac)
# shellcheck source=./sdd-common.sh
. "$script_dir/sdd-common.sh"

if [ "$#" -lt 3 ] || [ "$#" -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD [OUTFILE]" >&2
  exit 2
fi

plan=$(sdd_normalize_path "$1") || {
  echo "SDD_PATH_CONVERSION_FAILED: shell=bash path=$1 fallback=PowerShell" >&2
  exit 2
}
base=$2
head=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
sdd_plan_worktree_root "$plan" >/dev/null || exit 2

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }
commits=$(git rev-list --count "${base}..${head}")
[ "$commits" -gt 0 ] || {
  echo "REVIEW_PACKAGE_EMPTY_RANGE: no commits in ${base}..${head}" >&2
  exit 3
}
if git diff --quiet "${base}..${head}"; then
  echo "REVIEW_PACKAGE_EMPTY_DIFF: no file changes in ${base}..${head}" >&2
  exit 3
else
  diff_status=$?
  [ "$diff_status" -eq 1 ] || {
    echo "REVIEW_PACKAGE_DIFF_FAILED: git diff exited ${diff_status}" >&2
    exit 3
  }
fi

if [ "$#" -eq 4 ]; then
  out=$(sdd_normalize_path "$4") || {
    echo "SDD_PATH_CONVERSION_FAILED: shell=bash path=$4 fallback=PowerShell" >&2
    exit 2
  }
else
  dir=$("$script_dir/sdd-workspace" "$plan")
  out="$dir/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}"
} > "$out"

if [ ! -s "$out" ]; then
  echo "REVIEW_PACKAGE_WRITE_FAILED: output is missing or empty: $out" >&2
  exit 3
fi

if command -v wc >/dev/null 2>&1 && bytes=$(wc -c < "$out" 2>/dev/null); then
  bytes=${bytes//[[:space:]]/}
  echo "wrote ${out}: ${commits} commit(s), ${bytes} bytes"
else
  echo "REVIEW_PACKAGE_BYTE_COUNT_UNAVAILABLE: wc not found; package integrity verified" >&2
  echo "wrote ${out}: ${commits} commit(s)"
fi
