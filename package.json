{
  "name": "big-five-ui-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node app/dev-server.mjs",
    "prototype": "node prototype-big-five/prototype-server.mjs",
    "test": "node --test app/tests/*.test.js prototype-big-five/tests/*.test.js",
    "test:formal": "node --test app/tests/*.test.js",
    "check": "node scripts/check-static.mjs",
    "character:ledger": "node scripts/characters/validate-ledger.mjs",
    "character:convert": "node scripts/characters/convert-characters.mjs",
    "character:inspect": "node scripts/characters/inspect-character.mjs",
    "character:manifest": "node scripts/characters/generate-manifest.mjs",
    "character:check": "node scripts/characters/check-character-assets.mjs",
    "brand:build": "node scripts/brand/build-brand-icons.mjs",
    "content:validate": "node scripts/content/validate-content.mjs --source content/source",
    "content:preview:palettes": "node scripts/content/render-palette-preview.mjs --source content/source --output docs/palette-preview.html",
    "content:build": "node scripts/content/build-content.mjs --source content/source --output app/content --allowed-parent app",
    "qa:preview:build": "node scripts/qa/build-qa-preview.mjs --app app --output dist/qa-preview --allowed-parent ."
  },
  "devDependencies": {
    "sharp": "0.35.3"
  }
}
